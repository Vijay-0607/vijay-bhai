# Server Environment Variables
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/mandimatch?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────────────────
# JWT signing secret — minimum 32 characters, cryptographically random
JWT_ACCESS_SECRET="replace-with-at-least-32-char-secret-access"
JWT_REFRESH_SECRET="replace-with-at-least-32-char-secret-refresh"

# Token lifetimes (e.g. "15m", "7d", "1h")
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN="http://localhost:5173"

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Password Recovery ───────────────────────────────────────────────────────
# In development, reset tokens are logged to the console.
# In production, configure an email provider below.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=yoursmtppassword
# SMTP_FROM="MandiMatch <noreply@example.com>"

# Reset token lifetime in minutes
PASSWORD_RESET_EXPIRES_MINUTES=30

# ─── Admin ───────────────────────────────────────────────────────────────────
# Admin user is created via the seed script. Do not set role=admin in public signup.
# The seed script will create an admin account with these credentials in dev:
ADMIN_SEED_EMAIL="admin@mandimatch.internal"
ADMIN_SEED_PASSWORD="ChangeMe_Admin_2025!"
