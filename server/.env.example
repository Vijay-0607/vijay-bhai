# Server Environment Variables
# Copy this file to .env and fill in real values for your environment.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase transaction pooler for application queries (port 6543).
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.hqxaxgzwveqmauwflevm:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# Supabase session pooler for Prisma migrations (port 5432).
DIRECT_URL="postgresql://postgres.hqxaxgzwveqmauwflevm:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Security ────────────────────────────────────────────────────────────────
# JWT signing secret — minimum 32 characters, cryptographically random
JWT_ACCESS_SECRET="replace-with-at-least-32-char-secret-access"
JWT_REFRESH_SECRET="replace-with-at-least-32-char-secret-refresh"

# Token lifetimes (e.g. "15m", "7d", "1h")
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN="http://localhost:5173"

# ─── Cookies ─────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Password Recovery ───────────────────────────────────────────────────────
# In development, reset tokens are logged to the console.
# In production, configure an email provider below.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=yoursmtppassword
# SMTP_FROM="MandiMatch <noreply@example.com>"

# Reset token lifetime in minutes
PASSWORD_RESET_EXPIRES_MINUTES=30

# ─── OTP delivery ────────────────────────────────────────────────────────────
# Email via Resend: use a verified sender domain/address.
RESEND_API_KEY=
OTP_EMAIL_FROM="MandiMatch <login@your-verified-domain.com>"
# SMS OTP via MSG91 (recommended) or Twilio Verify. Keep credentials private.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Optional fallback provider if MSG91 is not configured.
TWILIO_ACCOUNT_SID=
# Preferred: create a Standard or appropriately restricted API key in Twilio Console.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alternative legacy credential (keep private; rotate if it has been exposed).
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_EXPIRES_MINUTES=5

# ─── Admin ───────────────────────────────────────────────────────────────────
# Admin user is created via the seed script. Do not set role=admin in public signup.
# The seed script will create an admin account with these credentials in dev:
ADMIN_SEED_EMAIL="admin@mandimatch.internal"
ADMIN_SEED_PASSWORD="ChangeMe_Admin_2025!"
